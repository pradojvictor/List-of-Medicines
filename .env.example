# Modelo das variáveis de ambiente necessárias.
# Copie para .env e preencha os valores:  cp .env.example .env
#
# ATENÇÃO: este arquivo É versionado. Nunca coloque valores reais aqui.

# ID do gist que contém a lista de medicamentos.
# É a parte final da URL do gist: gist.github.com/usuario/<ESTE_TRECHO>
GITHUB_GIST_ID=

# Personal Access Token do GitHub, com escopo de leitura de gist.
GITHUB_TOKEN=

# Opcional — nome do arquivo dentro do gist (padrão: medicines.json).
GITHUB_FILENAME=medicines.json
